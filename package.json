{
  "name": "tinypet",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "tinyPet",
    "tinyPetApp",
    "shared"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "yarn workspace @tinypet/web dev",
    "dev:app": "yarn workspace @tinypet/app start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "yarn workspace @tinypet/web db:up",
    "db:generate": "yarn workspace @tinypet/web db:generate",
    "db:push": "yarn workspace @tinypet/web db:push",
    "db:migrate": "yarn workspace @tinypet/web db:migrate",
    "db:seed": "yarn workspace @tinypet/web db:seed",
    "db:studio": "yarn workspace @tinypet/web db:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "nodemailer": "^10.0.12"
  }
}
