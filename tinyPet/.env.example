# tinyPet (web + API + database). Copy to tinyPet/.env — read by Next.js and the Prisma CLI.
# Database (MySQL)
DATABASE_URL="mysql://root:tinypet@localhost:3307/tinypet"

# Web / API
NEXTAUTH_URL="http://localhost:3033"
# In production both secrets are REQUIRED, >= 32 chars and not these placeholders (the app refuses to boot).
# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET="change-me-nextauth"
JWT_SECRET="change-me-jwt"
NEXT_PUBLIC_APP_URL="http://localhost:3033"
# Extra origins allowed by CORS (comma-separated), e.g. the Expo web build. localhost:* is allowed only in development.
CORS_ORIGINS=""
# Set to 1 ONLY behind a reverse proxy you control that overwrites X-Forwarded-For (used for per-IP rate limits).
# Production (EC2 / Oracle behind nginx/Caddy): set 1 and make the proxy overwrite X-Forwarded-For with $remote_addr.
TRUST_PROXY=""

# Social login (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Media storage: AWS S3 (required in production; without S3_BUCKET files go to tinyPet/public/uploads in dev only)
S3_BUCKET=""
AWS_REGION="sa-east-1"
# S3_REGION overrides AWS_REGION for the bucket (optional)
S3_REGION=""
# Leave empty to use the default AWS credential chain (IAM role on AWS, env/profile elsewhere)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Public base URL for media (CloudFront or custom domain). Default: https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_URL=""
# Only for S3-compatible local testing (LocalStack/MinIO), e.g. http://localhost:4566
S3_ENDPOINT=""

# Google Routes API (optional; falls back to straight-line estimate)
GOOGLE_MAPS_API_KEY=""

# Pagar.me (phase 3)
PAGARME_SECRET_KEY=""
PAGARME_PUBLIC_KEY=""
# Webhook HTTP Basic credentials (configure the same user/password in the Pagar.me dashboard).
# When empty, every webhook is rejected with 401 (fail closed).
PAGARME_WEBHOOK_USER=""
PAGARME_WEBHOOK_PASSWORD=""

# E-mail (optional; in development logs to console when empty; in production messages are dropped with a warning)
SMTP_URL=""
EMAIL_FROM="tinyPet <no-reply@tinypet.com.br>"

# Blog: salt for the daily visitor hash (falls back to NEXTAUTH_SECRET)
BLOG_VIEW_SALT=""

# Jobs: server crontab calls /api/v1/jobs/* with "Authorization: Bearer <CRON_SECRET>" (or header x-cron-secret). See docs/deploy.md.
# >= 16 chars; placeholders are rejected in production. Generate with: openssl rand -hex 32
CRON_SECRET="change-me-cron"

# Seed (prisma/seed.ts)
# SEED_DEMO=0 skips demo users/partner. In production the seed refuses to run unless SEED_DEMO=1 or SEED_ALLOW_PRODUCTION=1.
SEED_DEMO=""
SEED_ALLOW_PRODUCTION=""
# Admin password for the seed (default "tinypet123" only outside production; required for the admin in production).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Breed facts (dogs/cats) from https://api-ninjas.com — optional. Responses are cached in the database (api_cache)
# and the API is called only on a cache miss. Commercial use requires an API Ninjas premium plan.
API_NINJAS_KEY=""
