# tinyPetApp (Expo iOS/Android). Copy to tinyPetApp/.env — Expo inlines EXPO_PUBLIC_* at build time.
# API base URL (the tinyPet web project). Physical device: machine IP, e.g. http://192.168.0.10:3033.
# Android emulator: http://10.0.2.2:3033. Production builds require https.
EXPO_PUBLIC_API_URL="http://localhost:3033"
